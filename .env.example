DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/dbname?sslmode=require"
OPENROUTER_API_KEY="your-openrouter-api-key"
# Text / reasoning model (tax advisory, classification)
OPENROUTER_MODEL="deepseek/deepseek-v4-pro"
# Vision model for receipt/bill/invoice OCR (must support images)
OPENROUTER_VISION_MODEL="deepseek/deepseek-v4.1-flash"
# Comma-separated fallbacks tried when primary is rate-limited/unavailable (must support images for OCR)
OPENROUTER_FALLBACK_MODELS="anthropic/claude-opus-4.8,google/gemini-2.5-pro,google/gemini-2.5-flash"
NEXT_PUBLIC_APP_NAME="AI Finance OS"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
BLOB_READ_WRITE_TOKEN=""
